# Copier ce fichier en .env.local pour le développement, et déclarer les mêmes
# variables dans Vercel → Settings → Environment Variables pour la production.

# Formulaire de contact — clé gratuite sur https://web3forms.com
# (sans clé, le formulaire ouvre le logiciel de messagerie du visiteur)
VITE_WEB3FORMS_KEY=

# Avis Google (lus par la fonction serveur api/reviews.js — jamais exposés au navigateur)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
