# ─────────────────────────────────────────────────────────────
# Les Carillons — configuration Apache pour l'hébergement OVH (mutualisé).
# Équivalent de vercel.json : adresses propres, redirections, en-têtes, cache.
# Ce fichier est copié tel quel dans dist/ au build, puis envoyé à la racine du site (dossier www/).
# Ignoré par Vercel / Cloudflare.
# ─────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Toujours en HTTPS et sur www (seulement pour le vrai domaine : l'adresse provisoire OVH reste utilisable pour tester)
  RewriteCond %{HTTP_HOST} lescarillons\.fr$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.lescarillons.fr%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^lescarillons\.fr$ [NC]
  RewriteRule ^ https://www.lescarillons.fr%{REQUEST_URI} [R=301,L]

  # 2. Anciennes adresses de l'ancien site → nouvelles pages (même liste que vercel.json)
  RewriteRule ^hotel-2/?$ /hotel [R=301,L]
  RewriteRule ^contact-2/?$ /contact [R=301,L]
  RewriteRule ^2021/11/22/menu-stockfish/?$ /restaurant#menus [R=301,NE,L]
  RewriteRule ^2023/12/26/soiree-etape/?$ /hotel#soiree-etape [R=301,NE,L]

  # 3. Adresses propres : /hotel.html → /hotel, /index.html → /, pas de « / » final
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 4. Avis Google : /api/reviews → api/reviews.php (équivalent de la fonction Vercel)
  RewriteRule ^api/reviews$ api/reviews.php [L,QSA]

  # 5. /hotel → hotel.html (page pré-générée)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Cache : fichiers du build (nom change à chaque version) 1 an ; photos 30 jours ; pages HTML toujours revérifiées
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </ElseIf>
</IfModule>

# Compression et types de fichiers modernes
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Jamais de fichiers cachés ni de configuration accessibles depuis le web
<FilesMatch "^\.(?!well-known)|config\.php$">
  Require all denied
</FilesMatch>
